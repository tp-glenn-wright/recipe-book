{
  "name": "recipe-book",
  "version": "1.0.0",
  "private": true,
  "description": "Personal recipe book. Zero dependencies by design; see tools/security.mjs.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node --test tools/test.mjs",
    "validate": "node tools/recipes.mjs validate",
    "check": "node tools/recipes.mjs check",
    "security": "node tools/security.mjs",
    "serve": "node tools/build.mjs && python3 -m http.server 8000 -d dist"
  }
}
